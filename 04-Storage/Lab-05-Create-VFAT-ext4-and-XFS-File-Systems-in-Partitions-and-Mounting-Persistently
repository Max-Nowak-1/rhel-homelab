## Commands Used

sudo parted /dev/sde

mklabel msdos

sudo mkfs -t vfat /dev/sde1

sudo mkfs -t ext4 /dev/sde2

sudo mkfs -t xfs /dev/sde3

sudo mkdir /vfatfs5 /ext4fs5

sudo mount /dev/sde1 /vfatfs5

sudo mount /dev/sde2 /ext4fs5

findmnt /dev/sde1

findmnt /dev/sde2

lsblk -f

sudo umount /ext4fs5 /vfatfs5

findmnt /ext4fs5 /vfatfs5

sudo mount -a

df -h

